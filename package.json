{
  "name": "wirechat",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "WireChat LAN desktop chat application built with Electron, React, Vite, Fluent UI, Socket.IO, and SQLite.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "electron:attach": "wait-on http://127.0.0.1:5174 && electron ."
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.7",
    "@fluentui/react-icons": "^2.0.308",
    "electron-updater": "^6.8.3",
    "emoji-picker-react": "^4.19.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.wirechat.app",
    "productName": "WireChat",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:3001/updates/"
      }
    ],
    "directories": {
      "output": "C:\\Users\\Lenovo\\AppData\\Roaming\\WireChat\\wirechat-updates"
    },
    "extraResources": [
      {
        "from": "public/logo.ico",
        "to": "logo.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
